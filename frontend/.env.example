# This frontend always calls FastAPI. There is no browser-only demo adapter.
# Empty = same-origin /api, forwarded by Vite during local development.
VITE_API_BASE_URL=
# Dev / preview server proxy target. For a phone, use the Vite server's LAN URL.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Supabase: must match the backend's SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
# Each visitor is signed in anonymously so their data stays theirs. Leave both
# empty when the backend runs without Supabase. Never put a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
