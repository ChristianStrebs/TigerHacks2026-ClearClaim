# --- ClearClaim backend configuration ---
# Copy to `.env` and fill in real values. Never commit `.env`.

# Google Gemini API key (https://aistudio.google.com/app/apikey).
# If left empty, the backend runs in DEMO MODE with deterministic canned
# responses so the app is fully clickable without external calls.
GEMINI_API_KEY=

# Gemini models (defaults are the latest GA models).
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Backups tried in order when the chat model is overloaded (503) or out of quota (429).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# Per-request timeout before trying the next model.
GEMINI_TIMEOUT_SECONDS=30
# Embedding dimensionality. Must match the pgvector column + index.
EMBED_DIM=768

# Supabase — the shared ClearClaim project. Every visitor signs in anonymously and
# their plan, bill scans, and chats are saved privately per person (see
# supabase/migrations). The web app reads these from /api/health, so this is the
# only place to set them. Blank both to keep data in memory for one local member.
# Project URL only (no /rest/v1 path).
SUPABASE_URL=https://wopyaphsiuftdndyrhsg.supabase.co
# The publishable (public) key, safe to share. Requests carry each member's own login
# token, so row level security protects the data; no service role key is used.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_hJPYOwizQC12RXNhtqOqxw_ITJZoc3E

# CORS: comma-separated list of allowed browser origins. Native mobile apps don't
# need CORS; add your Expo web preview origin (e.g. http://localhost:8081) if used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo user's benefits profile (used for out-of-pocket estimates).
DEMO_DEDUCTIBLE_TOTAL=2000
DEMO_DEDUCTIBLE_MET=450
DEMO_COINSURANCE_RATE=0.2
DEMO_OOP_MAX=6000
